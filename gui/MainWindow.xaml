<Controls:MetroWindow
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    Title="ConfigMgr Lab Builder"
    Width="1200" Height="800"
    MinWidth="1000" MinHeight="640"
    WindowStartupLocation="CenterScreen"
    TitleCharacterCasing="Normal"
    ShowIconOnTitleBar="False"
    GlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    NonActiveGlowBrush="{DynamicResource MahApps.Brushes.Accent}"
    BorderThickness="1">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Steel.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Brand-standard sidebar button template: IsPressed shade-lift,
                 Foreground stays white, IsEnabled dimming via Opacity. -->
            <ControlTemplate x:Key="SidebarButtonTemplate" TargetType="Button">
                <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Margin="{TemplateBinding Padding}"
                                      RecognizesAccessKey="True"
                                      SnapsToDevicePixels="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Bd" Property="Background">
                            <Setter.Value>
                                <SolidColorBrush Color="#3A3A3A"/>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <Style x:Key="WorkflowButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource MahApps.Styles.Button.Square}">
                <Setter Property="Template" Value="{StaticResource SidebarButtonTemplate}"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Padding" Value="12,0,12,0"/>
                <Setter Property="Margin" Value="6,2,6,2"/>
                <Setter Property="Controls:ControlsHelper.ContentCharacterCasing" Value="Normal"/>
            </Style>

            <Style x:Key="OptionsButtonStyle" TargetType="Button"
                   BasedOn="{StaticResource WorkflowButtonStyle}"/>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}"/>
                <Setter Property="Margin" Value="12,16,0,6"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Grid.Column="0" LastChildFill="True">
            <!-- App title block -->
            <StackPanel DockPanel.Dock="Top" Margin="12,16,12,12">
                <!-- Wraps to two lines: "ConfigMgr Lab Builder" overflows the
                     fixed 220px sidebar at 20pt bold and was clipping to
                     "ConfigMgr Lab Build". -->
                <TextBlock Text="ConfigMgr Lab Builder"
                           TextWrapping="Wrap"
                           LineHeight="24" LineStackingStrategy="BlockLineHeight"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                <TextBlock x:Name="lblVersion"
                           Text="v1.4.0"
                           FontSize="10"
                           Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Bottom-docked toggle row -->
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Margin="12,8,12,12">
                <TextBlock DockPanel.Dock="Left"
                           Text="Dark theme"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                <Controls:ToggleSwitch x:Name="tglTheme"
                                       DockPanel.Dock="Right"
                                       IsOn="True"
                                       MinWidth="0"/>
            </DockPanel>

            <Separator DockPanel.Dock="Bottom" Margin="6,4,6,4"
                       Background="{DynamicResource MahApps.Brushes.Gray8}"/>

            <!-- Scrollable workflow area -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="WORKFLOW"/>
                    <Button x:Name="btnWelcome"  Style="{StaticResource WorkflowButtonStyle}" Content="Welcome"/>
                    <Button x:Name="btnTemplate" Style="{StaticResource WorkflowButtonStyle}" Content="Pick template"/>
                    <Button x:Name="btnHostCheck" Style="{StaticResource WorkflowButtonStyle}" Content="Host check"/>
                    <Button x:Name="btnMedia"    Style="{StaticResource WorkflowButtonStyle}" Content="Media"/>
                    <Button x:Name="btnTopology" Style="{StaticResource WorkflowButtonStyle}" Content="Topology"/>
                    <Button x:Name="btnPostCm"   Style="{StaticResource WorkflowButtonStyle}" Content="Post-CM"/>
                    <Button x:Name="btnReview"   Style="{StaticResource WorkflowButtonStyle}" Content="Review"/>
                    <Button x:Name="btnDeploy"   Style="{StaticResource WorkflowButtonStyle}" Content="Deploy"/>

                    <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="OPTIONS"/>
                    <Button x:Name="btnOptions"  Style="{StaticResource OptionsButtonStyle}"  Content="Options"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- Sidebar / content separator -->
        <Border Grid.Column="1"
                Background="{DynamicResource MahApps.Brushes.Gray8}"/>

        <!-- Main content area -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- module header band -->
                <RowDefinition Height="*"/>     <!-- module content -->
                <RowDefinition Height="5"/>     <!-- splitter -->
                <RowDefinition Height="160"/>   <!-- log drawer -->
                <RowDefinition Height="Auto"/>  <!-- status bar -->
            </Grid.RowDefinitions>

            <!-- Module header band -->
            <Border Grid.Row="0"
                    x:Name="bdModuleBand"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    Padding="16,12,16,10">
                <StackPanel>
                    <TextBlock x:Name="txtModuleTitle"
                               Text="Welcome"
                               FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource MahApps.Brushes.Text}"/>
                    <TextBlock x:Name="txtModuleSubtitle"
                               Text="ConfigMgr Lab Builder GUI"
                               FontSize="11"
                               Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Module content host -->
            <ContentControl x:Name="moduleHost"
                            Grid.Row="1"
                            Margin="8"/>

            <!-- Splitter -->
            <GridSplitter Grid.Row="2"
                          HorizontalAlignment="Stretch"
                          Height="5"
                          Background="{DynamicResource MahApps.Brushes.Gray8}"
                          ResizeDirection="Rows"/>

            <!-- Log drawer -->
            <Border Grid.Row="3">
                <DockPanel>
                    <TextBlock x:Name="lblLogOutput"
                               DockPanel.Dock="Top"
                               Text="LOG OUTPUT"
                               FontSize="10" FontWeight="SemiBold"
                               Margin="8,6,0,4"/>
                    <TextBox x:Name="txtLog"
                             IsReadOnly="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="11"
                             BorderThickness="0"
                             Margin="4,0,4,4"/>
                </DockPanel>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="4"
                    x:Name="bdStatusBar"
                    Padding="8,4,8,4"
                    Background="{DynamicResource MahApps.Brushes.Gray10}">
                <TextBlock x:Name="txtStatus"
                           Text="Ready."
                           FontSize="11"
                           Foreground="{DynamicResource MahApps.Brushes.Text}"/>
            </Border>
        </Grid>
    </Grid>

</Controls:MetroWindow>
