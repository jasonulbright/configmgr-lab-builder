<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,8,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="txtDeployStatus"
                           Text="Ready to deploy."
                           FontSize="14"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="txtDeployStep"
                           Text="No phase active."
                           FontSize="11"
                           Foreground="{DynamicResource MahApps.Brushes.Gray1}"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <Controls:ProgressRing x:Name="ringDeploy"
                                    Grid.Column="1"
                                    IsActive="False"
                                    Width="40" Height="40"/>
        </Grid>

        <Border Grid.Row="1"
                BorderThickness="0,1,0,1"
                BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="lbPhases"
                         Grid.Row="0"
                         Margin="8,8,8,0"
                         BorderThickness="0">
                    <!-- Populated at runtime from the engine's phase list -->
                    <ListBoxItem Content="01-Prereq      - waiting"/>
                    <ListBoxItem Content="02-Network     - waiting"/>
                    <ListBoxItem Content="03-Image       - waiting"/>
                    <ListBoxItem Content="04-VM          - waiting"/>
                    <ListBoxItem Content="05-Domain      - waiting"/>
                    <ListBoxItem Content="07-CMPrereqs   - waiting"/>
                    <ListBoxItem Content="06-Sql         - waiting"/>
                    <ListBoxItem Content="08-CM          - waiting"/>
                    <ListBoxItem Content="09-CMConfig    - waiting"/>
                    <ListBoxItem Content="10-Tools       - waiting"/>
                    <ListBoxItem Content="11-PostCM      - waiting"/>
                </ListBox>

                <ProgressBar x:Name="pbDeploy"
                             Grid.Row="1"
                             Margin="8,4,8,8"
                             Height="8"
                             Minimum="0" Maximum="100" Value="0"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="8,12,8,8">
            <Button x:Name="btnDeployStart"
                    Style="{DynamicResource MahApps.Styles.Button.Square.Accent}"
                    Content="Start deploy"
                    MinWidth="160"
                    Height="32"
                    Margin="0,0,8,0"
                    Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
            <Button x:Name="btnDeployCancel"
                    Style="{DynamicResource MahApps.Styles.Button.Square}"
                    Content="Cancel"
                    MinWidth="100"
                    Height="32"
                    Controls:ControlsHelper.ContentCharacterCasing="Normal"/>
        </StackPanel>
    </Grid>
</UserControl>
